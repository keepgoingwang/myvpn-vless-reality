# MyVPN：VLESS + REALITY 服务端配置模板
# 首次安装时 install.sh 会读取此文件，作为安装目标目录 server.env 的默认配置来源。
# 模板不包含真实密钥；VLESS_UUID、REALITY 密钥和 SUBSCRIBE_TOKEN 留空时由安装器自动生成。
# 配置优先使用大写 SERVER_PORT；为兼容旧配置，脚本也支持小写 server_port。

# 协议类型：当前脚本支持 vless-reality。
PROTOCOL=vless-reality

# VLESS 服务端 TCP 监听端口。修改后请同步放行云厂商安全组与主机防火墙。
SERVER_PORT=18388

# VLESS 客户端身份 UUID；首次安装自动生成，不需要手动填写。
VLESS_UUID=

# REALITY 服务端私钥；首次安装自动生成，必须保密。
REALITY_PRIVATE_KEY=

# REALITY 服务端公钥；首次安装自动生成，并用于客户端配置。
REALITY_PUBLIC_KEY=

# REALITY Short ID；首次安装自动生成，格式为 2-16 个十六进制字符（偶数长度）。
REALITY_SHORT_ID=

# REALITY 客户端 SNI 伪装域名。
REALITY_SNI=www.cloudflare.com

# REALITY 握手目标服务器；当前简化配置要求与 REALITY_SNI 相同。
REALITY_HANDSHAKE_SERVER=www.cloudflare.com

# REALITY 握手目标服务器端口，通常为 443；它不是本机代理监听端口。
REALITY_HANDSHAKE_PORT=443

# 客户端中显示的节点名称。
NODE_NAME=US-Aliyun

# VPS 公网 IPv4；留空时安装器或 generate-config.sh 自动探测并更新。
PUBLIC_IP=68.166.252.25

# 是否启用 HTTP 订阅文件：true 启用，false 关闭。
ENABLE_SUBSCRIPTION=true

# 订阅 URL 使用的随机 Token；留空时自动生成。Token 不会加密订阅内容。
SUBSCRIBE_TOKEN=8a3d6346709bb95bd4236fd4af0de5465f3d8793939428a3

# 可选的订阅域名；留空时使用公网 IPv4 生成订阅地址。
DOMAIN=

# Nginx HTTP 订阅端口；修改后请同步放行安全组与防火墙。
NGINX_HTTP_PORT=80

# 是否由脚本添加/管理 UFW 规则：true 管理，false 不修改 UFW。
# 此设置不会修改阿里云等云厂商的安全组。
ENABLE_UFW=true

# SSH 服务端口，仅在 ENABLE_UFW=true 时用于添加 SSH 放行规则。
SSH_PORT=22

# 当前脚本只配置 HTTP 订阅，不会自动申请证书或部署 HTTPS，保持 false。
ENABLE_HTTPS=false
