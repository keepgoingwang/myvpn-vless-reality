# 示例模板，不是可直接运行的 server.env。请先执行 install.sh 初始化 UUID 和 REALITY 密钥。
PROTOCOL=vless-reality
SERVER_PORT=443
VLESS_UUID=
REALITY_PRIVATE_KEY=
REALITY_PUBLIC_KEY=
REALITY_SHORT_ID=
REALITY_SNI=www.microsoft.com
REALITY_HANDSHAKE_SERVER=www.microsoft.com
REALITY_HANDSHAKE_PORT=443
NODE_NAME=US-Aliyun
# install.sh / generate-config.sh 自动探测并更新公网 IPv4，一般无需手动填写。
PUBLIC_IP=
ENABLE_SUBSCRIPTION=true
SUBSCRIBE_TOKEN=
DOMAIN=
NGINX_HTTP_PORT=80
ENABLE_UFW=true
SSH_PORT=22
